.mypy_cache/
Thumbs.db
.DS_Store
desktop.ini
*.db-shm
*.db-wal

# Logs
logs/
*.log

# GIS Temporary & Auxiliary Files
temp/
tmp/
*.aux.xml
*.ovr
*.tfw

# Raw LiDAR Point Clouds (>100MB)
*.las
*.laz

# Large GIS binary datasets (>50MB) in national_server
national_server/**/*.shp
national_server/**/*.dbf
national_server/**/*.sbn
national_server/**/*.sbx
national_server/**/*.zip
national_server/**/*.gpkg
national_server/**/*_Pachet_Unic.geojson
national_server/**/*_Poligoane_*.geojson
national_server/**/*_Puncte_*.geojson

# AutoCAD temporary locks
*.dwl
*.dwl2

# Secrets & Local Environment
.env
.env.*
*.env
!.env.example

# Local Agent / MCP Configurations
.mcp.json
.claude/settings.local.json

# AI Models & Large Weights (>100MB)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
models/sam2/*.pt
models/sam2/*.pth
models/sam2/*.onnx
# Allow verified compact ONNX decoders (<100MB)
!models/sam2/sam2_decoder.onnx

# Workspace runtime logs, locks, and temporary files
workspace/logs/
workspace/*.db
workspace/*~
workspace/**/*.aux.xml
.kilo/
scratch/
scratch_*.py
tools/llm_test_results/
.ipynb_checkpoints/

