# Aider
.aider*

# Python & Virtual Environments
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# VS Code & IDE Sidecars
.vscode/
.idea/
.pytest_cache/
.mypy_cache/
Thumbs.db
.DS_Store
desktop.ini

# Logs
logs/
*.log

# GIS Temporary & Auxiliary Files
temp/
tmp/
*.aux.xml
*.ovr
*.tfw

# Raw LiDAR Point Clouds (>100MB)
*.las
*.laz

# AutoCAD temporary locks
*.dwl
*.dwl2

# Secrets & Local Environment
.env
.env.*
*.env
!.env.example

# Local Agent / MCP Configurations
.mcp.json
.claude/settings.local.json

# AI Models & Large Weights (>100MB)
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
*.h5
models/sam2/*.pt
models/sam2/*.pth
models/sam2/*.onnx
# Allow verified compact ONNX decoders (<100MB)
!models/sam2/sam2_decoder.onnx

# Workspace runtime logs, locks, and temporary files
workspace/logs/
workspace/*.db
workspace/*~
workspace/**/*.aux.xml
.kilo/
scratch/
scratch_*.py
tools/llm_test_results/
.ipynb_checkpoints/

# Obsidian & Agents
Obsidian workflow/
.agents/skills/
skills-lock.json
