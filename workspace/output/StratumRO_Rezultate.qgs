    <!-- CLADIRI SOL ANCPI (Semafor Încredere V2) -->
    <maplayer id="layer_cladiri_sol" name="StratumRO — Clădiri Sol ANCPI (-40cm) (29 Clădiri)" type="vector" geometry="Polygon" minScale="1e+08" maxScale="0" styleCategories="AllStyleCategories" readOnly="0">
      <id>layer_cladiri_sol</id>
