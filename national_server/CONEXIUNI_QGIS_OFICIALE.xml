  <arcgisfeatureserver>
    <connection name="RO - cIMeC Patrimoniu Arheologic RAN (ArcGIS REST)" url="https://eism.geo-spatial.ro/eismgeo/rest/services/Patrimoniu/PatrimoniuWM/MapServer"/>
